      "parameters": {
        "jsCode": "const item = $input.first();\n\nlet httpStatus = null;\nlet apiStatus = null;\nlet apiMessage = null;\n\nconst raw = item.json?.error?.message;\n\nif (typeof raw === 'string') {\n\n  // 1. Extract HTTP status code\n  const statusMatch = raw.match(/^(\\d{3})\\s*-/);\n  if (statusMatch) {\n    httpStatus = parseInt(statusMatch[1], 10);\n  }\n\n  // 2. Extract the quoted JSON string after \" - \"\n  const quotedJsonMatch = raw.match(/-\\s*\"(.*)\"$/);\n  if (quotedJsonMatch) {\n    try {\n      // 3. Unescape the JSON string\n      const unescaped = quotedJsonMatch[1].replace(/\\\\\"/g, '\"');\n\n      // 4. Parse JSON\n      const parsed = JSON.parse(unescaped);\n\n      apiStatus = parsed.status;\n      apiMessage = parsed.message;\n    } catch (e) {\n      // Ignore malformed JSON safely\n    }\n  }\n}\n\nreturn [\n  {\n    json: {\n      httpStatus,\n      apiStatus,\n      apiMessage,\n    },\n  },\n];\n"
      },
